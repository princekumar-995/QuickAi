# Server Environment Configuration Example
PORT=3000

# Authentication (Clerk credentials)
# CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# CLERK_SECRET_KEY=your_clerk_secret_key

# OpenAI Integration
# Setup your official OpenAI developer platform API key here
OPENAI_API_KEY=your_openai_api_key_here

# Gemini Integration
# Setup your official Google Gemini API Key here (OpenAI compatibility layer will handle routing)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter Integration
# Setup your OpenRouter API Key for fallbacks
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database Connectivity
# DATABASE_URL=your_postgresql_database_url_here
